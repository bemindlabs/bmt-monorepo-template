# Development Dockerfile
FROM node:22-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Install Bun runtime (using official Alpine package or direct download)
RUN apk add --no-cache curl unzip bash && \
    curl -fsSL https://bun.sh/install | bash && \
    ln -s /root/.bun/bin/bun /usr/local/bin/bun && \
    ln -s /root/.bun/bin/bunx /usr/local/bin/bunx

# Install development tools
RUN apk add --no-cache git

WORKDIR /app

# Copy entrypoint scripts
COPY infra/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose ports (web: 3000/5173, api: 3010)
EXPOSE 3000 5173 3010

# Use entrypoint script to install deps and start dev server
ENTRYPOINT ["/docker-entrypoint.sh"]
